# Model API keys for OpenLLM-Eval. Copy to secrets.env (never commit it).
#
# Only variables starting with OPENLLM_SECRET_ can be used. An endpoint refers to one by name,
# for example secret reference:  env:OPENLLM_SECRET_VLLM_KEY
# Keys are never stored in the database, returned by the API, logged, or put in reports.
#
# Only the api and worker containers read this file. Apply changes with:
#   docker compose up -d api worker
#
# Wrap values containing $ in single quotes so Compose does not treat them as variables:
#   OPENLLM_SECRET_X='abc$def'

# OPENLLM_SECRET_VLLM_KEY=replace-me
# OPENLLM_SECRET_OPENAI_KEY=sk-...
