# Copy to .env and adjust. Never commit .env.

# --- Deployment ---
# Address the host ports bind to. 127.0.0.1 = this machine only.
# Set to 0.0.0.0 to reach the UI/API from other machines. Everyone must sign in (see
# Authentication below); for anything beyond a test network, put a TLS proxy in front.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
API_PORT=8000
ENVIRONMENT=production
OPENLLM_VERSION=0.0.1

# --- PostgreSQL ---
POSTGRES_DB=openllm_eval
POSTGRES_USER=openllm
# REQUIRED: choose a strong password. Compose refuses to start without it.
# Any characters are allowed, but wrap the value in SINGLE quotes if it contains `$`,
# otherwise Docker Compose treats `$name` as a variable and silently drops it:
#   POSTGRES_PASSWORD='P@ss$word#1'
# PostgreSQL only applies this password when its volume is first created. To change it
# later on an empty install: docker compose down -v && docker compose up -d --build
POSTGRES_PASSWORD=change-me

# --- Model endpoint network policy (SSRF protection) ---
# Self-hosted model servers (vLLM on your LAN, or the mock-llm service) have private IPs.
# Either allow private networks generally...
ENDPOINT_ALLOW_PRIVATE_NETWORKS=false
# ...or, preferably, list exactly which destinations are allowed (hostnames, *.suffix, IPs, CIDRs).
# When set, ONLY these destinations are allowed.
#   ENDPOINT_ALLOWED_HOSTS=mock-llm,vllm.lan,10.0.5.0/24
ENDPOINT_ALLOWED_HOSTS=
# Cloud metadata and link-local addresses are always blocked. These hostnames are blocked too.
ENDPOINT_BLOCKED_HOSTS=postgres,redis
# Maximum bytes read from one model response (default 16 MB).
ENDPOINT_MAX_RESPONSE_BYTES=16777216
# Directory that custom CA certificates must live in (empty = disabled). If you set it, also mount
# the directory into the api and worker containers (e.g. a docker-compose.override.yml volume).
CA_CERT_DIR=

# --- Dataset limits ---
# Max upload size (25 MB; keep below nginx's 50 MB body limit), records per version, and bytes
# per normalized record (long-context cases are the large ones).
DATASET_MAX_UPLOAD_BYTES=26214400
DATASET_MAX_RECORDS=20000
DATASET_MAX_RECORD_BYTES=4194304

# --- Benchmark runs ---
# Limits per run model, and whether generated text is stored with results (truncated to
# RUN_RESPONSE_MAX_CHARS). Set RUN_STORE_RESPONSES=false to keep only timings and token counts.
RUN_MAX_REQUESTS=100000
RUN_MAX_CONCURRENCY=256
RUN_STORE_RESPONSES=true
RUN_RESPONSE_MAX_CHARS=20000

# --- Reports ---
# Recorded attempts included in a report or export (metrics always cover the whole run).
REPORT_MAX_RESULTS=50000

# --- Authentication ---
# Sign-in is required by default. false = everyone is an administrator (trusted single-user
# machine only).
AUTH_ENABLED=true
# Encrypts the directory (LDAP) bind password and Kerberos keytab stored in the database. Any
# random string of 16+ characters; deploy.sh generates one if empty. Keep it: changing it makes
# stored directory secrets unreadable (re-enter them in Settings > Authentication).
AUTH_SECRET_KEY=
# The first administrator, created when the database has no users. deploy.sh generates the
# password if empty and prints it once. It must be changed at first sign-in; afterwards this
# value is not used again (you may delete it).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Sessions end after this much inactivity, and in any case after AUTH_SESSION_MAX_HOURS.
AUTH_SESSION_IDLE_MINUTES=480
AUTH_SESSION_MAX_HOURS=72
# Session cookie Secure flag: auto (when the browser used HTTPS), true, or false.
AUTH_COOKIE_SECURE=auto
# Failed sign-ins: lock a username after AUTH_LOCKOUT_THRESHOLD failures in 15 minutes, a client
# address after AUTH_LOCKOUT_IP_THRESHOLD, for AUTH_LOCKOUT_SECONDS.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_IP_THRESHOLD=20
AUTH_LOCKOUT_SECONDS=900
# Other origins allowed to make changes with a session cookie, comma-separated, e.g. when the UI
# is published under another host name than the one the browser sends: https://llm-eval.corp.example
AUTH_TRUSTED_ORIGINS=
# Build the Kerberos (Windows single sign-on) libraries into the image. false skips them;
# Active Directory password sign-in still works.
WITH_KERBEROS=true
# Active Directory / LDAP and Kerberos are configured in the UI: Settings > Authentication.

# --- Tool sandbox (integration-mode tool calls) ---
# Off by default. To execute tool calls for real, set true and deploy with
# `bash scripts/deploy.sh --tools`. Tools are declared in tools/tools.yaml (see
# docs/user-guide/tool-sandbox.md); they run only inside the isolated tool-runner container.
TOOL_EXECUTION_ENABLED=false
# Shared secret between the worker and the tool runner; deploy.sh --tools generates it.
TOOL_RUNNER_TOKEN=
# Hosts HTTP tools may call (comma-separated host names, IPs or CIDRs). Empty = HTTP tools are
# blocked. The tool runner must also be attached to the test service's network.
TOOL_ALLOWED_HOSTS=
# Per-call memory limit for script tools, and the runner's container limits.
TOOL_SCRIPT_MEMORY_MB=256
TOOL_RUNNER_MAX_CONCURRENCY=8
TOOL_RUNNER_MEMORY=1g
TOOL_RUNNER_CPUS=1.0

# --- Model API keys ---
# Not here: put OPENLLM_SECRET_* variables in secrets.env (see secrets.env.example).

# --- Logging ---
LOG_LEVEL=INFO
# json (default, for log aggregation) or console (human-readable)
LOG_FORMAT=json

# --- Local (non-Docker) backend development ---
# When running the backend directly with `uv run`, it reads backend/.env.
# Defaults: DATABASE_URL=sqlite+aiosqlite:///./openllm_eval.db, REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://openllm:change-me@localhost:5432/openllm_eval
# REDIS_URL=redis://localhost:6379/0
# CORS_ORIGINS=http://localhost:5173
